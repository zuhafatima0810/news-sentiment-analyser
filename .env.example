# News API key from https://newsapi.org/
NEWS_API_KEY=YOUR_API_KEY_HERE

# Email settings (use App Password for Gmail)
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECEIVER=recipient@example.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Analysis settings
QUERY=technology
SOURCES=
PAGE_SIZE=50

# Scheduler settings (24-hour format)
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0

# Output directories
CHART_OUTPUT_DIR=output/charts
REPORT_OUTPUT_DIR=output/reports
